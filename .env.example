# API keys for paid model runs (shelflife.cli run). Copy to .env, fill in only the providers you need,
# then load it into your shell before running:   set -a; source .env; set +a
# .env is ignored by git. Never commit real keys. Offline commands (list, show, plan, rescore, tests) need none.

# Anthropic direct (models routed 'anthropic' in code/shelflife/models.py, e.g. M119, M140, M206)
ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenAI direct (models routed 'openai', e.g. M015, M133, M204, M207)
OPENAI_API_KEY=your-openai-key-here

# OpenRouter (every other model, e.g. M017, M045, M090, M102, M196)
OPENROUTER_API_KEY=your-openrouter-key-here
